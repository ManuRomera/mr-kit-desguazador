<form class="{{cssClass}} mr-kit-hoja" autocomplete="off">

  {{!-- Cabecera: como la del personaje --}}
  <header class="mr-kit-cab">
    <img class="profile" src="{{img}}" data-edit="img" title="{{name}}" />
    <div class="mr-kit-cab-campos">
      <div class="mr-kit-campo mr-kit-campo-nombre">
        <div class="headerinputtext">{{localize 'Mosh.ShipIdentifier'}}</div>
        <div class="headerinputfield charname"><input name="name" class="noborder" type="text" value="{{name}}" /></div>
      </div>
      <div class="mr-kit-campo">
        <div class="headerinputtext">Clase</div>
        <div class="headerinputfield charname"><input name="system.class" class="noborder" type="text" value="{{system.class}}" /></div>
      </div>
      <div class="mr-kit-campo mr-kit-campo-transp">
        <div class="headerinputtext">{{localize 'Mosh.Transponder'}}</div>
        <label class="mr-kit-transp"><input class="checkbox" type="checkbox" name="system.transponder" data-dtype="Boolean" {{checked system.transponder}} />
          <span>{{#if system.transponder}}{{localize 'Mosh.Enabled'}}{{else}}{{localize 'Mosh.Disabled'}}{{/if}}</span></label>
      </div>
      <div class="mr-kit-campo mr-kit-campo-make">
        <div class="headerinputtext">Marca / modelo / Salto / Clase / tipo</div>
        <div class="headerinputfield charname"><textarea name="system.make" rows="2" class="noborder">{{system.make}}</textarea></div>
      </div>
    </div>
  </header>

  <div class="mr-kit-centro">

    {{!-- Características: como las del personaje --}}
    <div class="mr-kit-caracteristicas">
      <div class="mainstatwrapper">
        <div class="resource mainstat">
          <div class="mainstatlabel"><span class="ability-mod rollable mr-kit-tirada mainstattext" data-key="thrusters" data-tooltip="Tirada de Propulsores">{{localize 'Mosh.Thrusters'}}</span></div>
          <input class="circle-input" type="text" name="system.stats.thrusters.value" value="{{system.stats.thrusters.value}}" data-dtype="Number" />
        </div>
      </div>
      <div class="mainstatwrapper">
        <div class="resource mainstat">
          <div class="mainstatlabel"><span class="ability-mod rollable mr-kit-tirada mainstattext" data-key="battle" data-tooltip="Tirada de Batalla">{{localize 'Mosh.Battle'}}</span></div>
          <input class="circle-input" type="text" name="system.stats.battle.value" value="{{system.stats.battle.value}}" data-dtype="Number" />
        </div>
      </div>
      <div class="mainstatwrapper">
        <div class="resource mainstat">
          <div class="mainstatlabel"><span class="ability-mod rollable mr-kit-tirada mainstattext" data-key="systems" data-tooltip="Tirada de Sistemas">{{localize 'Mosh.Systems'}}</span></div>
          <input class="circle-input" type="text" name="system.stats.systems.value" value="{{system.stats.systems.value}}" data-dtype="Number" />
        </div>
      </div>
      <div class="mainstatwrapper">
        <div class="resource mainstat">
          <div class="mainstatlabel"><span class="ability-mod rollable mainstattext bankruptcy-button" data-tooltip="Salvación de Quiebra">{{localize 'Mosh.Bankruptcy'}}</span></div>
          <input class="circle-input" type="text" name="system.stats.bankruptcy.value" value="{{system.stats.bankruptcy.value}}" data-dtype="Number" />
        </div>
      </div>
    </div>

    {{!-- Recursos --}}
    <div class="mr-kit-recursos">
      <div class="resource healthspread minmaxtopstat">
        <label class="resource-label minmaxtext">Casco</label>
        <div class="minmaxwrapper">
          <input class="maxhealth-input darkGreyText" type="text" name="system.supplies.hull.value" value="{{system.supplies.hull.value}}" data-dtype="Number" />
          <div class="slant"></div>
          <input class="maxhealth-input darkGreyText" type="text" name="system.supplies.hull.max" value="{{system.supplies.hull.max}}" data-dtype="Number" />
        </div>
        <div class="healthmaxtext">{{localize 'Mosh.Current'}}</div>
        <div class="healthmaxtext">{{localize 'Mosh.Maximum'}}</div>
      </div>
      <div class="resource healthspread minmaxtopstat">
        <label class="resource-label minmaxtext">{{localize 'Mosh.Fuel'}}</label>
        <div class="minmaxwrapper">
          <input class="maxhealth-input darkGreyText" type="text" name="system.supplies.fuel.value" value="{{system.supplies.fuel.value}}" data-dtype="Number" />
          <div class="slant"></div>
          <input class="maxhealth-input darkGreyText" type="text" name="system.supplies.fuel.max" value="{{system.supplies.fuel.max}}" data-dtype="Number" />
        </div>
        <div class="healthmaxtext">{{localize 'Mosh.Current'}}</div>
        <div class="healthmaxtext">{{localize 'Mosh.Maximum'}}</div>
      </div>
      <div class="resource healthspread minmaxtopstat">
        <label class="resource-label minmaxtext">{{localize 'Mosh.Crew'}}</label>
        <div class="minmaxwrapper">
          <input class="maxhealth-input darkGreyText" type="text" name="system.supplies.crew.value" value="{{system.supplies.crew.value}}" data-dtype="Number" />
          <div class="slant"></div>
          <input class="maxhealth-input darkGreyText" type="text" name="system.supplies.crew.max" value="{{system.supplies.crew.max}}" data-dtype="Number" />
        </div>
        <div class="healthmaxtext">{{localize 'Mosh.Current'}}</div>
        <div class="healthmaxtext">{{localize 'Mosh.Maximum'}}</div>
      </div>
      <div class="mr-kit-circulos">
        <div class="mr-kit-circulo"><input class="circle-input" type="text" name="system.supplies.warp-cores.value" value="{{system.supplies.warp-cores.value}}" data-dtype="Number" /><span>Núcleos warp</span></div>
        <div class="mr-kit-circulo"><input class="circle-input" type="text" name="system.supplies.cryopods.value" value="{{system.supplies.cryopods.value}}" data-dtype="Number" /><span>{{localize 'Mosh.Cryopods'}}</span></div>
        <div class="mr-kit-circulo"><input class="circle-input" type="text" name="system.supplies.escape-pods.value" value="{{system.supplies.escape-pods.value}}" data-dtype="Number" /><span>{{localize 'Mosh.EscapePods'}}</span></div>
        <div class="mr-kit-circulo"><input class="circle-input" type="text" name="system.stats.oxygen.value" value="{{system.stats.oxygen.value}}" data-dtype="Number" /><span>O₂</span></div>
      </div>
    </div>

    {{!-- Tripulación: panel negro, como Cordura/Miedo/Cuerpo --}}
    <aside class="mr-kit-tripulacion">
      <div class="mr-kit-trip-titulo">{{localize 'Mosh.Crew'}}</div>
      <div class="mr-kit-trip-lista">
        {{#each crew as |miembro|}}
        <div class="mr-kit-miembro item" data-item-id="{{miembro._id}}">
          <img src="{{miembro.img}}" alt="" />
          <div class="mr-kit-miembro-datos">
            <span class="mr-kit-miembro-nombre">{{miembro.name}}</span>
            <span class="mr-kit-miembro-puesto">{{{miembro.system.job}}}</span>
          </div>
          <span class="mr-kit-miembro-ctl">
            <a class="item-control item-edit" title="{{localize 'Mosh.EditCrewMember'}}"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="{{localize 'Mosh.DeleteCrewMember'}}"><i class="fas fa-trash"></i></a>
          </span>
        </div>
        {{else}}
        <p class="mr-kit-trip-vacio">Arrastra aquí a los personajes que viajan en la nave: sus habilidades se suman a las tiradas y reciben el Estrés.</p>
        {{/each}}
      </div>
      <a class="item-control weapon-create mr-kit-trip-anadir" title="{{localize 'Mosh.CreateCrewMember'}}" data-type="crew"><i class="fas fa-plus"></i> {{localize 'Mosh.Add'}} PNJ</a>
    </aside>
  </div>

  {{!-- Megadaño: los nueve efectos, siempre a la vista --}}
  <section class="mr-kit-mdmg">
    <div class="mr-kit-mdmg-cab">
      <span class="mr-kit-mdmg-titulo">{{localize 'Mosh.Megadamage'}}</span>
      <span class="mr-kit-mdmg-total" data-tooltip="Megadaño acumulado">{{mrKit.mdmgTotal}}</span>
      <span class="mr-kit-mdmg-efecto">{{{mrKit.efectoActual}}}</span>
    </div>
    <div class="mr-kit-mdmg-pasos">
      {{#each mrKit.pasos as |paso|}}
      <a class="megadamage-button mr-kit-paso {{#if paso.activo}}activo{{/if}}" data-key="{{paso.n}}" data-tooltip="{{paso.texto}}">{{paso.n}}</a>
      {{/each}}
    </div>
  </section>

  {{!-- Acciones --}}
  <div class="mr-kit-acciones-nave">
    <a class="button-black mr-kit-accion" data-accion="mantenimiento"><i class="fa-solid fa-wrench"></i> Mantenimiento</a>
    <a class="button-black mr-kit-accion" data-accion="socorro"><i class="fa-solid fa-tower-broadcast"></i> Socorro</a>
    <a class="button-black mr-kit-accion" data-accion="moral"><i class="fa-solid fa-flag"></i> Moral enemiga</a>
    <a class="button-black mr-kit-accion" data-accion="reparar"><i class="fa-solid fa-screwdriver-wrench"></i> Reparar</a>
    <a class="button-black mr-kit-accion" data-accion="viaje"><i class="fa-solid fa-route"></i> Viaje</a>
    <a class="button-black mr-kit-accion deckplan-button"><i class="fa-solid fa-map"></i> Plano de cubierta</a>
  </div>

  <nav class="mosh sheet-tabs tabs mr-kit-pestanas" id="sheet-tabs" data-group="primary">
    <a class="tab-select" data-tab="weapons">{{localize 'Mosh.Weapons'}}</a>
    <a class="tab-select" data-tab="modules">{{localize 'Mosh.Upgrades'}}</a>
    <a class="tab-select" data-tab="cargo">{{localize 'Mosh.Cargo'}}</a>
    <a class="tab-select" data-tab="repairs">{{localize 'Mosh.Repairs'}}</a>
    <a class="tab-select" data-tab="description">{{localize 'Mosh.Notes'}}</a>
  </nav>

  <section class="sheet-body mr-kit-cuerpo" id="sheet-body">

    {{!-- Armas --}}
    <div class="tab items" data-group="primary" data-tab="weapons">
      <div class="mr-kit-armas-resumen">
        <div class="resource healthspread minmaxtopstat">
          <label class="resource-label minmaxtext">{{localize 'Mosh.Weapons'}}</label>
          <div class="minmaxwrapper">
            <input class="maxhealth-input darkGreyText" type="text" name="system.weapon-stats.weapons.value" value="{{system.weapon-stats.weapons.value}}" data-dtype="Number" />
            <div class="slant"></div>
            <input class="maxhealth-input darkGreyText" type="text" name="system.weapon-stats.weapons.max" value="{{system.weapon-stats.weapons.max}}" data-dtype="Number" />
          </div>
          <div class="healthmaxtext">{{localize 'Mosh.Base'}}</div>
          <div class="healthmaxtext">{{localize 'Mosh.Total'}}</div>
        </div>
        <div class="resource healthspread minmaxtopstat">
          <label class="resource-label minmaxtext">{{localize 'Mosh.Megadamage'}}</label>
          <div class="minmaxwrapper">
            <input class="maxhealth-input darkGreyText" type="text" name="system.weapon-stats.megadamage.value" value="{{system.weapon-stats.megadamage.value}}" data-dtype="String" />
            <div class="slant"></div>
            <input class="maxhealth-input darkGreyText" type="text" name="system.weapon-stats.megadamage.max" value="{{system.weapon-stats.megadamage.max}}" data-dtype="String" />
          </div>
          <div class="healthmaxtext">{{localize 'Mosh.Base'}}</div>
          <div class="healthmaxtext">{{localize 'Mosh.Total'}}</div>
        </div>
        <div class="resource healthspread minmaxtopstat">
          <label class="resource-label minmaxtext">Anclajes</label>
          <div class="minmaxwrapper">
            <input class="maxhealth-input darkGreyText" type="text" name="system.weapon-stats.hardpoints.value" value="{{system.weapon-stats.hardpoints.value}}" data-dtype="Number" />
            <div class="slant"></div>
            <input class="maxhealth-input darkGreyText" type="text" name="system.weapon-stats.hardpoints.max" value="{{system.weapon-stats.hardpoints.max}}" data-dtype="Number" />
          </div>
          <div class="healthmaxtext">{{localize 'Mosh.Installed'}}</div>
          <div class="healthmaxtext">{{localize 'Mosh.Maximum'}}</div>
        </div>
      </div>

      {{#if mrKit.estadoArmas}}<p class="mr-kit-armas-estado {{mrKit.estadoArmas.clase}}"><i class="fa-solid {{mrKit.estadoArmas.icono}}"></i> <span>{{mrKit.estadoArmas.texto}}</span>
        {{#if mrKit.estadoArmas.terminar}}<a class="mr-kit-enlace" data-accion="terminar" data-tooltip="Se hace solo al cerrar el combate del Combat Tracker">Terminar el combate</a>{{/if}}
        {{#if mrKit.estadoArmas.rearmar}}<a class="mr-kit-enlace" data-accion="rearmar-todas">Rearmar todas</a>{{/if}}</p>{{/if}}

      <ol class="items-list">
        <li class="item flexrow item-header">
          <div class="item-image"></div>
          <div class="skill-stat" style="flex-grow: 2;">{{localize 'Mosh.Name'}}</div>
          <div class="skill-stat">{{localize 'Mosh.Bonus'}}</div>
          <div class="item-controls">
            <a class="item-control weapon-create" title="Crear arma" data-type="weapon"><i class="fas fa-plus"></i>{{localize 'Mosh.Add'}}</a>
          </div>
        </li>
        {{#each weapons as |weapon|}}
        <li class="item flexrow dropitem" data-item-id="{{weapon._id}}">
          <div class="item-image"><img src="{{weapon.img}}" title="{{weapon.name}}" width="24" height="24" /></div>
          <div class="skill-name weapon-roll list-roll" style="flex-grow: 2;" data-tooltip="Disparar: tirada de Batalla contra la nave marcada como objetivo (T)">{{weapon.name}}</div>
          <div class="skill-stat">{{weapon.system.bonus}}</div>
          <div class="item-controls">
            {{#if weapon.mrVacia}}<a class="item-control mr-kit-rearmar vacia" data-tooltip="Sin reabastecer: pulsa para rearmar" aria-label="Rearmar {{weapon.name}}"><i class="fa-solid fa-battery-empty"></i></a>
            {{else}}<span class="item-control mr-kit-rearmar cargada" data-tooltip="Cargada"><i class="fa-solid fa-battery-full"></i></span>{{/if}}
            <a class="item-control weapon-edit" title="{{localize 'Mosh.EditWeapon'}}"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="{{localize 'Mosh.DeleteWeapon'}}"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>

    {{!-- Mejoras --}}
    <div class="tab items" data-group="primary" data-tab="modules">
      <div class="mr-kit-armas-resumen">
        <div class="resource healthspread minmaxtopstat">
          <label class="resource-label minmaxtext">{{localize 'Mosh.Upgrades'}}</label>
          <div class="minmaxwrapper">
            <input class="maxhealth-input darkGreyText" type="text" name="system.supplies.upgrades.value" value="{{system.supplies.upgrades.value}}" data-dtype="Number" />
            <div class="slant"></div>
            <input class="maxhealth-input darkGreyText" type="text" name="system.supplies.upgrades.max" value="{{system.supplies.upgrades.max}}" data-dtype="Number" />
          </div>
          <div class="healthmaxtext">{{localize 'Mosh.Installed'}}</div>
          <div class="healthmaxtext">{{localize 'Mosh.Maximum'}}</div>
        </div>
      </div>
      <ol class="items-list">
        <li class="item flexrow item-header">
          <div class="item-image"></div>
          <div class="skill-stat" style="flex-grow: 2;">{{localize 'Mosh.ModuleName'}}</div>
          <div class="skill-stat">{{localize 'Mosh.Quantity'}}</div>
          <div class="skill-stat">{{localize 'Mosh.Cost'}}</div>
          <div class="skill-stat" style="flex-grow: 2;">{{localize 'Mosh.Feature'}}</div>
          <div class="item-controls">
            <a class="item-control item-create" title="{{localize 'Mosh.CreateModule'}}" data-type="module"><i class="fas fa-plus"></i>{{localize 'Mosh.Add'}}</a>
          </div>
        </li>
        {{#each modules as |module|}}
        <li class="item flexrow dropitem" data-item-id="{{module._id}}">
          <div class="item-image"><img src="{{module.img}}" title="{{module.name}}" width="24" height="24" /></div>
          <h4 class="skill-name list-roll description-roll" style="flex-grow: 2;">{{module.name}}</h4>
          <div class="skill-stat list-roll item-quantity">{{module.system.quantity}}</div>
          <div class="skill-stat">{{module.system.cost}}</div>
          <div class="skill-stat" style="flex-grow: 2;">{{module.system.feature}}</div>
          <div class="item-controls">
            <a class="item-control item-edit" title="{{localize 'Mosh.EditModule'}}"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="{{localize 'Mosh.DeleteModule'}}"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>

    {{!-- Carga --}}
    <div class="tab items" data-group="primary" data-tab="cargo">
      <ol class="items-list">
        <li class="item flexrow item-header">
          <div class="item-image"></div>
          <div class="skill-stat" style="flex-grow: 2;">{{localize 'Mosh.ItemName'}}</div>
          <div class="skill-stat">{{localize 'Mosh.Quantity'}}</div>
          <div class="skill-stat">{{localize 'Mosh.Weight'}}</div>
          <div class="skill-stat">{{localize 'Mosh.Value'}}</div>
          <div class="item-controls">
            <a class="item-control item-create" title="{{localize 'Mosh.CreateItem'}}" data-type="item"><i class="fas fa-plus"></i> {{localize 'Mosh.Add'}}</a>
          </div>
        </li>
        {{#each cargo as |item|}}
        <li class="item flexrow dropitem" data-item-id="{{item._id}}">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24" /></div>
          <h4 class="skill-name list-roll description-roll" style="flex-grow: 2;">{{item.name}}</h4>
          <div class="skill-stat list-roll item-quantity">{{item.system.quantity}}</div>
          <div class="skill-stat">{{item.system.weight}}</div>
          <div class="skill-stat">{{item.system.cost}}</div>
          <div class="item-controls">
            <a class="item-control item-edit" title="{{localize 'Mosh.EditItem'}}"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="{{localize 'Mosh.DeleteItem'}}"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>

    {{!-- Reparaciones --}}
    <div class="tab items" data-group="primary" data-tab="repairs">
      <ol class="items-list">
        <li class="item flexrow item-header">
          <div class="item-image"></div>
          <div class="skill-stat" style="flex-grow: 2;">{{localize 'Mosh.Repairs'}}</div>
          <div class="skill-stat">Tipo</div>
          <div class="item-controls">
            <a class="item-control item-create" title="Añadir avería" data-type="repair" data-subtype="minor"><i class="fas fa-plus"></i> {{localize 'Mosh.Add'}}</a>
          </div>
        </li>
        {{#each majorRepairs as |item|}}
        <li class="item flexrow dropitem" data-item-id="{{item._id}}">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24" /></div>
          <h4 class="skill-name list-roll description-roll" style="flex-grow: 2;">{{item.name}}</h4>
          <div class="skill-stat">Mayor</div>
          <div class="item-controls">
            <a class="item-control item-edit" title="Editar"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="Borrar"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
        {{#each minorRepairs as |item|}}
        <li class="item flexrow dropitem" data-item-id="{{item._id}}">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24" /></div>
          <h4 class="skill-name list-roll description-roll" style="flex-grow: 2;">{{item.name}}</h4>
          <div class="skill-stat">Menor</div>
          <div class="item-controls">
            <a class="item-control item-edit" title="Editar"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="Borrar"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>

    {{!-- Notas: descripción, plano de cubierta y reglas propias de la nave --}}
    <div class="tab biography" data-group="primary" data-tab="description">
      {{editor system.biography target="system.biography" button=true owner=owner editable=editable}}
    </div>
  </section>
</form>
